{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Category for grouping menu items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "object" },
        "icon": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "slug", "name", "icon", "order"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Restaurant menu item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "object" },
        "description": { "type": "object" },
        "ingredients": { "type": "object" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "dietaryTags": { "type": "array" },
        "allergens": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["id", "categoryId", "name", "description", "price", "image", "isAvailable"]
    },
    "RestaurantSettings": {
      "title": "RestaurantSettings",
      "description": "General settings and info for the restaurant",
      "type": "object",
      "properties": {
        "name": { "type": "object" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "adminPin": { "type": "string" },
        "allowTableOrdering": { "type": "boolean" },
        "allowWaiterCall": { "type": "boolean" }
      },
      "required": ["name", "phone", "whatsappNumber", "adminPin"]
    },
    "TableOrder": {
      "title": "TableOrder",
      "description": "Customer order from a dining table or delivery/takeaway",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tableNumber": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "tableNumber", "items", "total", "status", "timestamp"]
    },
    "WaiterCall": {
      "title": "WaiterCall",
      "description": "Dine-in table waiter call alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tableNumber": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "tableNumber", "type", "status", "timestamp"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Menu categories list"
    },
    "/menuItems/{itemId}": {
      "schema": "MenuItem",
      "description": "Restaurant menu items"
    },
    "/restaurantSettings/{settingId}": {
      "schema": "RestaurantSettings",
      "description": "Global restaurant configurations"
    },
    "/tableOrders/{orderId}": {
      "schema": "TableOrder",
      "description": "Customer orders"
    },
    "/waiterCalls/{callId}": {
      "schema": "WaiterCall",
      "description": "Customer waiter calls"
    }
  }
}
