rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Menu Items
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Restaurant Settings
    match /restaurantSettings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Table Orders
    match /tableOrders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && incoming().tableNumber is string && incoming().total is number;
      allow update, delete: if isSignedIn();
    }

    // Waiter Calls
    match /waiterCalls/{callId} {
      allow read: if true;
      allow create: if isValidId(callId) && incoming().tableNumber is string;
      allow update, delete: if isSignedIn();
    }
  }
}
